from pyjsx import JSX, jsx


def LoginCta(*, children=None, next_url="") -> JSX:
    return (
        <div class="panel">
            <p class="muted">Melde dich mit deinen Bluesky-Account an, um dieses Angebot zu bestätigen.</p>
            <a class="btn btn-primary" href={"/auth/login?next=" + next_url}>Mit Bluesky anmelden</a>
        </div>
    )


def ConfirmPanel(*, children=None, confirm_url="", offerer="") -> JSX:
    return (
        <div class="panel">
            <p class="muted">
                Sobald du bestätigst, wirst du <strong>@{offerer}</strong> folgen – dein Follow wird im selben Schritt erwidert.
            </p>
            <button class="btn btn-primary btn-lg" hx-post={confirm_url} hx-swap="outerHTML" hx-target="#offer-action">
                Follow-Swap bestätigen
            </button>
        </div>
    )


def ResultPanel(*, children=None, ok=False, text="") -> JSX:
    cls = "notice notice-ok" if ok else "notice notice-error"
    return <div class="panel"><p class={cls}>{text}</p><a class="btn btn-ghost" href="/">Zum Dashboard</a></div>


def CancelPanel(*, children=None, cancel_url="", resend_url="", dm_failed=False) -> JSX:
    resend = None
    if dm_failed:
        resend = <button class="btn btn-ghost" hx-post={resend_url} hx-swap="outerHTML" hx-target="#offer-action">DM erneut senden</button>
    return (
        <div class="panel">
            <p class="muted">Du wartest darauf, dass die Person das Angebot bestätigt.</p>
            <button class="btn btn-ghost" hx-post={cancel_url} hx-swap="outerHTML" hx-target="#offer-action">Angebot zurückziehen</button>
            {resend}
        </div>
    )


def OfferStartButton(*, children=None, target_handle="") -> JSX:
    hx_vals = '{"target": "' + target_handle + '"}'
    return (
        <div class="panel">
            <button class="btn btn-primary btn-lg" hx-post="/offers" hx-swap="outerHTML" hx-target="#offer-action" hx-vals={hx_vals}>
                Follow-Swap anbieten
            </button>
            <p class="muted">Die Person wird per Bluesky-DM benachrichtigt. Du folgst erst, wenn sie zustimmt – dann tauscht ihr sofort.</p>
        </div>
    )


def OfferCreatedPanel(*, children=None, offer_url="") -> JSX:
    return (
        <div class="panel">
            <p class="notice notice-ok">Angebot erstellt und per DM gesendet.</p>
            <a class="btn btn-primary" href={offer_url}>Angebot ansehen</a>
        </div>
    )


def InfoPanel(*, children=None, text="") -> JSX:
    return (
        <div class="panel">
            <p class="muted">{text}</p>
            <a class="btn btn-ghost" href="/">Zum Dashboard</a>
        </div>
    )