# MutualSky – Docker/Uvicorn-Konfiguration
# Nach data/.env kopieren und anpassen (nicht in git einchecken).

# Öffentliche Basis-URL (OAuth client_id + Redirect abgeleitet daraus).
# ACHTUNG: Domain-Wechsel invalidiert alle bestehenden Logins (OAuth-Constraint).
PUBLIC_BASE_URL=https://mutualsky.example.com

# SQLite-Datenbank liegt im gemounteten data-Volumen.
DATABASE_URL=sqlite:///app/data/mutualsky.db

# Geheime Schlüssel – generieren mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
APP_SECRET=change-me

# Signaturschlüssel des OAuth-Confidential-Clients (ES256 JWK), generieren mit:
#   uv run python scripts/generate_jwk.py
OAUTH_CLIENT_SECRET_JWK={"kty":"EC",...}

# OAuth-Scopes (transition:chat.bsky nur nötig, wenn DMs gesendet werden sollen)
# OAUTH_SCOPE=atproto transition:generic transition:chat.bsky

# Secure-Cookie auf https zwingend; lokal (http) auf false stellen!
COOKIE_SECURE=true

# DM-Versand an die angefragte Person
DM_ENABLED=true

# Angebots-Frist in Tagen
OFFER_TTL_DAYS=14